cat("CAN: 数据框创建成功。\n")
# --- 数据清洗与预处理 ---
rmse_column_to_use <- "RMSE_target" # 使用 RMSE_target 列
# 由于数据是直接创建的，我们可以简化检查
raw_data <- raw_data %>%
filter(!is.na(.data[[rmse_column_to_use]]))
# 确保 'method' 列是因子类型，并按特定顺序排列
# 我们可以手动指定顺序，让图表更美观
desired_order <- c("D_opt", "G_opt", "PM", "LHS", "CVT")
raw_data$method <- factor(raw_data$method, levels = desired_order)
method_names <- levels(raw_data$method)
n_methods <- length(method_names)
# --- 3. 计算摘要统计信息 (用于绘制均值点) ---
summary_stats <- raw_data %>%
group_by(method) %>%
summarise(
mean_RMSE = mean(.data[[rmse_column_to_use]], na.rm = TRUE),
.groups = 'drop'
)
# --- 4. 定义颜色调色板 (使用手动指定的颜色以保持一致性) ---
light_colors <- c(
"D_opt"   = "#F8766D",  # 类似红色
"G_opt"   = "#7CAE00",  # 类似绿色
"PM"      = "#00BFC4",  # 类似青色
"LHS"     = "#C77CFF",  # 类似紫色
"CVT"     = "#FFC107"   # 类似橙色
)[desired_order]
dark_colors <- c(
"D_opt"   = "#E41A1C",
"G_opt"   = "#4DAF4A",
"PM"      = "#377EB8",
"LHS"     = "#984EA3",
"CVT"     = "#FF7F00"
)[desired_order]
names(light_colors) <- method_names
names(dark_colors) <- method_names
# --- 5. 创建箱线图并叠加散点 ---
rmse_boxplot_no_legend <- ggplot(raw_data, aes(x = method, y = .data[[rmse_column_to_use]])) +
geom_jitter(
aes(color = method),
width = 0.25,
size = 2.0,
alpha = 0.9
) +
geom_boxplot(
aes(fill = method),
width = 0.6,
lwd = 0.8,
alpha = 0.7,
outlier.shape = NA
) +
# 添加均值点
geom_point(
data = summary_stats,
aes(x=method, y = mean_RMSE),
shape = 18, # 菱形
size = 4,
color = "black"
) +
# --- 6. 自定义外观 ---
scale_fill_manual(
values = light_colors
) +
scale_color_manual(
values = dark_colors
) +
labs(
x = "Method",
y = "RMSE"
) +
# 使用 theme_bw() 而不是 theme_minimal() 可以更容易地控制边框和轴线
theme_bw(base_size = global_font_size) +
theme(
plot.title = element_blank(),
axis.text = element_text(face = "bold", color = "black"), # 统一设置轴标签
axis.title.x = element_text(face = "bold", margin = margin(t = 15)),
axis.title.y = element_text(
face = "bold",
angle = 0, # 保持Y轴标题水平
vjust = 0.5,
margin = margin(r = 15)
),
legend.position = "none", # 隐藏图例
# --- 移除网格线并只保留X/Y轴线 ---
panel.grid.major = element_blank(), # 移除主要网格线
panel.grid.minor = element_blank(), # 移除次要网格线
panel.border = element_blank(),     # 移除面板边框
axis.line = element_line(colour = "black", linewidth = 0.5) # 添加坐标轴线
)
# --- 7. 显示图表 ---
if (n_methods > 0) {
print(rmse_boxplot_no_legend)
cat("CAN: 代码执行完毕。已根据您提供的数据生成RMSE对比箱线图。\n")
} else {
cat("CAN: 警告！没有足够的数据来生成图表。\n")
}
