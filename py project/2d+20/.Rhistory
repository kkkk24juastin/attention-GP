install.packages("tgp")
rm(list=ls(all=TRUE))
options(scipen = 999)
library(tgp)
library(lhs)
library(DiceKriging)
library(ggplot2)
library(plotly)
library(ggplot2)
# 定义具有非平稳边界的测试函数
non_test_function <- function(x, y) {
step_function <- ifelse(x > 0, 1, 0)
result <- ifelse(
step_function == 1,
2*sin(x) + y^2,
x^2 + y^2
)
return(result)
}
# 创建 x 和 y 的网格数据
x <- seq(-2, 2, length.out = 100)
y <- seq(-2, 2, length.out = 100)
grid <- expand.grid(x = x, y = y)
# 计算 z 值
grid$z <- with(grid, non_test_function(x, y))
# 定义 MATLAB 风格的 jet 颜色
jet_colors <- c("#00007F", "blue", "#007FFF", "cyan", "#7FFF7F",
"yellow", "#FF7F00", "red", "#7F0000")
###############################################################
slhd_xiu <- function(m, n, L, U) {
xtrain <- matrix(0, nrow = m, ncol = n)
for (i in 1:n) {
X_train <- lhs::randomLHS(m, 1)  # 使用随机拉丁超立方采样
XF1 <- X_train[, 1]
xtrain[, i] <- (U[i] - L[i]) * XF1 + L[i]
}
return(xtrain)
}
TRUETEST <- function(X) {
x <- X[,1]
y <- X[,2]
Z <- non_test_function(x, y)
return(Z)
}
pool_data <- function(xx, U) {
Theta <- cbind(xx, U)  # Pool data with xx and U
return(Theta)
}
##################
optimal_design_ql <- function(Theta_true, Theta, chosen_index, n_s, sigma, tol, X) {
m_x <- nrow(Theta)
m_y <- ncol(Theta)
index_plot <- c()
# 响应接近目标值的权重
target_value <- c(1.5)  # 响应值目标
score <- as.numeric()
for (i in 1:n_s) {
Theta_chosen <- Theta_true[chosen_index, , drop = FALSE]
space_filling <- rep(0, m_x)
response_penalty <- rep(0, m_x)
for (j in 1:m_x) {
if (!(j %in% chosen_index)) {
space <- matrix(X[j, , drop = FALSE], nrow = nrow(X[chosen_index, , drop = FALSE]), ncol = ncol(X), byrow = TRUE) - X[chosen_index, , drop = FALSE]
space_filling[j] <- min(sqrt(rowSums(space^2)))
# 使用EI计算期望改进
mu_pred <- Theta_true[j, 3]  # 使用Theta_true的第二列作为预测均值
sigma_pred <- sigma[j]  # 使用常数sigma，也可以改为动态计算
response_penalty[j] <- (mu_pred-target_value)^2+ sigma_pred # 计算EI作为响应罚函数
}
}
space_filling <- space_filling / max(space_filling)
response_penalty <- response_penalty / max(response_penalty)
temp <- log(space_filling) - log(response_penalty)
optimal <- which.max(temp)
chosen_index <- c(chosen_index, optimal)
index_plot <- c(index_plot, optimal)
score <- c(score, max(temp))
}
return(list(chosen_index = chosen_index, index_plot = index_plot, score = score))
}
#################################################
# main function #
#################################################
generate_nonstationary_data <- TRUETEST
# 初始化
ntrain <- 20
x <- slhd_xiu(ntrain, 2, c(-2, -2), c(2, 2))  # 生成20个二维训练输入
data <- generate_nonstationary_data(x)  # 计算对应的响应
y <- data
Xt <- slhd_xiu(2000, 2, c(-2, -2), c(2, 2))  # 生成1000个二维候选点
datat <- generate_nonstationary_data(Xt)
yt <- datat
X <- rbind(x, Xt)
U <- c(y, yt)  # 初始化响应矩阵
min(U)
# 选择初始设计点
chosen_index <- c(1:ntrain)
# 初始设计
x0 <- X[chosen_index, ]
u0 <- U[chosen_index]
min(u0)
max(u0)
# 初始化目标响应值
# optUy <- -0.2
# optU <- matrix(rep(optUy, each = 1000), ncol = 1, byrow = TRUE)
optU <- c(y, yt)
# 调用 pool_datanew 函数
Theta_true <- pool_data(X, optU)
scoreall <- as.numeric()
# 迭代过程
ns_max <- 20 # 最大迭代次数
n_s <- 1  # 每次选择的点数
for (s in 1:ns_max) {
print(paste("Iteration:", s))
# GP 模型训练和预测
btgpr <- btgp(X=x0, Z=u0, XX=X, verb=0)
pred1 <- btgpr$ZZ.mean
preU <- cbind(pred1)
sigma <- btgpr$ZZ.s2
# 聚合数据
Theta <- pool_data(X, preU)
Theta[chosen_index, 3] <- u0
Theta_true <- Theta
# 选择新的设计点
res <- optimal_design_ql(Theta_true, Theta, chosen_index, n_s, sigma = sigma, tol = 0.5, X = X)
chosen_index <- res$chosen_index
# 更新设计
x0 <- X[chosen_index, ]
u0 <- generate_nonstationary_data(x0) # 更新真实响应
scoreall <- c(scoreall, res$score)
}
# 输出最终设计
designmatrix <- cbind(x0, u0)
print(designmatrix)
###########################################
#===============plot======================
###########################################
x0_first <- x0[1:ntrain, ]
x0_last <- x0[ntrain:nrow(x0), ]
x0_first_df <- data.frame(x = x0_first[, 1], y = x0_first[, 2], group = "Group 1")
x0_last_df <- data.frame(x = x0_last[, 1], y = x0_last[, 2], group = "Group 2")
# 合并两个数据框
x0_df <- rbind(x0_first_df, x0_last_df)
contour_plot <- ggplot(grid, aes(x = x, y = y)) +
# 添加热图
geom_tile(aes(fill = z)) +
# 添加等高线
stat_contour(aes(z = z), color = "black") +
# 调整颜色梯度
scale_fill_gradientn(
colors = jet_colors,
guide = guide_colorbar(
title = NULL,  # 移除颜色条标题
title.position = "top",
label.position = "right",
barwidth = 1,     # 颜色条宽度
barheight = 20    # 颜色条高度
)
) +
# 添加红色加粗的等高线
stat_contour(aes(z = z), breaks = 1.5, color = "red", linewidth = 2) +
# 设置主题和标签
theme_minimal() +
labs(
x = expression(x[1]),  # 横轴名称改为x1带下标
y = expression(x[2]),  # 纵轴名称改为x2带下标
caption = ""
) +
# 添加点
geom_point(data = x0_first_df, aes(x = x, y = y, color = "初始训练样本"), size = 10) +
geom_point(data = x0_last_df, aes(x = x, y = y, color = "主动学习样本"), size = 10, shape = 18) +
# 调整点的颜色和图例
scale_color_manual(
name = NULL,  # 移除图例标题
values = c("初始训练样本" = "red", "主动学习样本" = "#FF8C00")
) +
# 修改坐标轴样式
theme(
# 调整坐标轴标题字体大小
axis.title = element_text(size = 28),
# 调整坐标轴刻度字体大小
axis.text = element_text(size = 28),
# 添加并修改坐标轴样式
axis.title.x = element_text(angle = 0, vjust = 0.5),  # 横轴标题方向和位置
axis.title.y = element_text(angle = 0, vjust = 0.5),  # 纵轴标题方向和位置
axis.line = element_line(color = "black", size = 1),  # 坐标轴加粗
# 调整图例字体大小和位置
legend.text = element_text(size = 28),
legend.title = element_blank(),  # 移除图例标题
legend.position = "right",    # 图例放在图外右侧
legend.box = "vertical",      # 图例和颜色条垂直排列
legend.margin = margin(l = 20), # 图例左边距
# 调整图标题/注释字体
plot.caption = element_text(
size = 36,
hjust = 0.5,
margin = margin(t = 20, b = -20)
),
# 调整整个绘图区域的外边距
plot.margin = margin(r = 100, b = 50)  # 增加右边距，为图例留出空间
)
print(contour_plot)
