# CAN: 我热爱编码！
# 任务: 创建一个多曲线、颜色自定义、带最高点标注的光滑飞行轨迹图（增强标签排斥 & 可调图例线长）。
# --- 1. 加载必要的库 ---
if (!requireNamespace("ggplot2", quietly = TRUE)) install.packages("ggplot2")
if (!requireNamespace("dplyr", quietly = TRUE)) install.packages("dplyr")
if (!requireNamespace("readr", quietly = TRUE)) install.packages("readr")
if (!requireNamespace("ggrepel", quietly = TRUE)) install.packages("ggrepel")
if (!requireNamespace("showtext", quietly = TRUE)) install.packages("showtext")
if (!requireNamespace("mgcv", quietly = TRUE)) install.packages("mgcv")
library(ggplot2)
library(dplyr)
library(readr)
library(ggrepel)
library(showtext)
# --- 2. 用户配置 ---
# 定义要绘制的CSV文件及其在图例中对应的标签
csv_files_to_plot <- c("DOPT.csv", "GOPT.csv", "LHS.csv", "CVT.csv", "PM.csv")
legend_labels_for_files <- c("D_opt", "G_opt", "LHS", "CVT", "PM")
# 定义颜色板
color_palette <- c(
"D_opt" = "#E41A1C", # Red
"G_opt" = "#377EB8", # Blue
"LHS"   = "#984EA3", # Purple
"CVT"   = "#4DAF4A", # Green
"PM"    = "#FF7F00"  # Orange
)
# 图例控制
show_legend <- TRUE
legend_title_text <- "Method"
# --- 2a. 新增：绘图微调参数 ---
# 【新功能】标签排斥力 (数值越大，标签推得越开，以防止重叠。推荐值 20-50)
label_repel_force <- 50
# 【新功能】图例中曲线的长度 (单位: cm)
legend_line_length_cm <- 3
# --- 3. 全局设置与字体配置 ---
global_font_size <- 30
font_add_google("Noto Sans SC", "notosans-sc")
showtext_auto()
# --- 4. 验证配置 ---
# (此部分无变化)
if (length(csv_files_to_plot) != length(legend_labels_for_files)) {
stop("CAN 错误: 文件数量与标签数量不匹配。")
}
if (length(csv_files_to_plot) == 0) {
stop("CAN 错误: 未指定任何CSV文件。")
}
if (!all(names(color_palette) %in% legend_labels_for_files) || !all(legend_labels_for_files %in% names(color_palette))) {
stop("CAN 错误: 标签与颜色板不完全匹配。")
}
# --- 5. 数据加载与准备 ---
# (此部分无变化)
all_data_list <- list()
tryCatch({
for (i in 1:length(csv_files_to_plot)) {
file_path <- csv_files_to_plot[i]
file_label <- legend_labels_for_files[i]
if (!file.exists(file_path)) {
stop(paste("文件未找到 - '", file_path, "'。", sep=""))
}
df_raw <- read_csv(file_path, col_names = c("Time", "Altitude"), col_types = cols(.default = "d"))
df_processed <- df_raw %>% mutate(Source = file_label)
all_data_list[[i]] <- df_processed
}
combined_df <- bind_rows(all_data_list)
combined_df$Source <- factor(combined_df$Source, levels = legend_labels_for_files)
}, error = function(e) {
stop(paste("CAN 错误: 读取或处理CSV文件时发生错误: ", e$message))
})
