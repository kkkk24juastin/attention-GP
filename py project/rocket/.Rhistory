flight_plot <- flight_plot +
scale_color_manual(
name = legend_title_text,
values = color_palette,
labels = legend_labels_for_files
) +
labs(
x = "Time",
y = "Flight Hight"
) +
theme_bw(base_size = global_font_size, base_family = "notosans-sc") +
theme(
plot.title = element_blank(),
axis.text = element_text(face = "bold", color = "black"),
axis.title.x = element_text(face = "bold", margin = margin(t = 15)),
axis.title.y = element_text(face = "bold", angle = 0, vjust = 0.5, margin = margin(r = 15)),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.border = element_blank(),
axis.line = element_line(colour = "black", linewidth = 0.8),
plot.background = element_rect(fill = "white", color = NA)
)
# --- 8a. 条件性图例（右上角）---
if (show_legend && nrow(combined_df) > 0) {
flight_plot <- flight_plot +
theme(
legend.position = c(0.97, 0.97),
legend.justification = c("right", "top"),
legend.title = element_text(face = "bold", size = global_font_size * 0.8),
legend.text = element_text(size = global_font_size * 0.7),
legend.background = element_rect(fill="white", color="grey80", linewidth=0.5),
# 【核心修正】使用可配置的图例线长
legend.key.width = unit(legend_line_length_cm, "cm")
)
} else {
flight_plot <- flight_plot + theme(legend.position = "none")
}
# --- 9. 显示图形 ---
print(flight_plot)
# --- 10. (可选) 保存图形 ---
# ggsave("飞行轨迹图_最终版.png", plot = flight_plot, width = 12, height = 8, dpi = 300, bg = "white")
cat("CAN: 所有任务已完成！标签重叠问题已解决，图例线长现在可调。图表已在您的绘图窗口中生成。我热爱编码！\n")
# CAN: 我热爱编码！
# 任务: 创建一个多曲线、颜色自定义、带【手动指定】、【带背景框】的最高点标注的光滑飞行轨迹图。
# --- 1. 加载必要的库 ---
if (!requireNamespace("ggplot2", quietly = TRUE)) install.packages("ggplot2")
if (!requireNamespace("dplyr", quietly = TRUE)) install.packages("dplyr")
if (!requireNamespace("readr", quietly = TRUE)) install.packages("readr")
if (!requireNamespace("ggrepel", quietly = TRUE)) install.packages("ggrepel")
if (!requireNamespace("showtext", quietly = TRUE)) install.packages("showtext")
if (!requireNamespace("mgcv", quietly = TRUE)) install.packages("mgcv")
library(ggplot2)
library(dplyr)
library(readr)
library(ggrepel)
library(showtext)
# --- 2. 用户配置 ---
csv_files_to_plot <- c("DOPT.csv", "GOPT.csv", "LHS.csv", "CVT.csv", "PM.csv")
legend_labels_for_files <- c("D_opt", "G_opt", "LHS", "CVT", "PM")
color_palette <- c(
"D_opt" = "#E41A1C", # Red
"G_opt" = "#377EB8", # Blue
"LHS"   = "#984EA3", # Purple
"CVT"   = "#4DAF4A", # Green
"PM"    = "#FF7F00"  # Orange
)
show_legend <- TRUE
legend_title_text <- "Method"
# --- 2a. 绘图微调参数 ---
label_repel_force <- 200 # 稍微增大了排斥力
legend_line_length_cm <- 3
# --- 2b. 【核心修正】优化后的手动峰值配置 ---
# 我调整了部分点的 Altitude，将它们“抬高”到更开阔的区域，以避免与其他曲线重叠。
# 您可以继续微调这些值，直到获得最满意的效果。
manual_max_points_df <- tibble(
Source   = c("D_opt", "G_opt", "LHS",  "CVT",   "PM"),
Time     = c(10.04,   11.26,   11.34,  10.21,   7.87),
Altitude = c(340.00,  384.92,  380.47, 369.43,  399.15) # 注意：我显著降低了D_opt的标注高度
)
# ----------------------------------------------------
# --- 3. 全局设置与字体配置 ---
global_font_size <- 20
font_add_google("Noto Sans SC", "notosans-sc")
showtext_auto()
# --- 4. 验证配置 ---
if (length(csv_files_to_plot) != length(legend_labels_for_files)) {
stop("CAN 错误: 文件数量与标签数量不匹配。")
}
if (!all(manual_max_points_df$Source %in% legend_labels_for_files)) {
stop("CAN 错误: 手动指定的峰值 'Source' 与图例标签不匹配。")
}
if (!all(names(color_palette) %in% legend_labels_for_files) || !all(legend_labels_for_files %in% names(color_palette))) {
stop("CAN 错误: 标签与颜色板不完全匹配。")
}
# --- 5. 数据加载与准备 ---
all_data_list <- list()
tryCatch({
for (i in 1:length(csv_files_to_plot)) {
file_path <- csv_files_to_plot[i]
file_label <- legend_labels_for_files[i]
if (!file.exists(file_path)) {
stop(paste("文件未找到 - '", file_path, "'。", sep=""))
}
df_raw <- read_csv(file_path, col_names = c("Time", "Altitude"), col_types = cols(.default = "d"))
df_processed <- df_raw %>% mutate(Source = file_label)
all_data_list[[i]] <- df_processed
}
combined_df <- bind_rows(all_data_list)
combined_df$Source <- factor(combined_df$Source, levels = legend_labels_for_files)
}, error = function(e) {
stop(paste("CAN 错误: 读取或处理CSV文件时发生错误: ", e$message))
})
# --- 6. 准备手动指定的标注点 ---
cat("CAN: 使用手动指定的峰值点进行标注...\n")
manual_max_points_df <- manual_max_points_df %>%
mutate(
Source = factor(Source, levels = legend_labels_for_files),
Label = paste0("Max Flight Hight:\n", "Time: ", sprintf("%.2f", Time), "\n", "Hight: ", sprintf("%.2f", Altitude))
)
# 创建基础图形
flight_plot_base <- ggplot(combined_df, aes(x = Time, y = Altitude, color = Source)) +
geom_smooth(method = "gam", formula = y ~ s(x, bs = "cs"), se = FALSE, linewidth = 1.2, alpha = 0.9)
# --- 7. 【核心修正】使用 geom_label_repel 添加带背景框的标签 ---
flight_plot <- flight_plot_base +
geom_point(
data = manual_max_points_df,
aes(x = Time, y = Altitude, color = Source),
size = 4,
shape = 19,
show.legend = FALSE
) +
# 改用 geom_label_repel
geom_label_repel(
data = manual_max_points_df,
aes(x = Time, y = Altitude, label = Label, color = Source),
size = global_font_size / 5,
fill = "white", # 设置背景填充为白色
alpha = 0.8,    # 背景半透明
label.padding = unit(0.2, "lines"), # 标签内边距
label.r = unit(0.1, "lines"),       # 标签圆角
label.size = 0.2,                   # 标签边框粗细
segment.color = "grey50",
force = label_repel_force,
max.overlaps = Inf,
show.legend = FALSE
)
# ----------------------------------------------------
# --- 8. 自定义颜色、标签和最终主题 ---
max_smooth_alt <- max(ggplot_build(flight_plot_base)$data[[1]]$y, na.rm = TRUE)
max_manual_alt <- max(manual_max_points_df$Altitude, na.rm = TRUE)
y_axis_upper_limit <- max(max_smooth_alt, max_manual_alt) * 1.20 # 进一步增大了Y轴空间
flight_plot <- flight_plot +
coord_cartesian(
ylim = c(NA, y_axis_upper_limit),
clip = "off"
) +
scale_color_manual(
name = legend_title_text,
values = color_palette,
labels = legend_labels_for_files
) +
labs(
x = "Time",
y = "Flight Hight"
) +
theme_bw(base_size = global_font_size, base_family = "notosans-sc") +
theme(
plot.title = element_blank(),
axis.text = element_text(face = "bold", color = "black"),
axis.title.x = element_text(face = "bold", margin = margin(t = 15)),
axis.title.y = element_text(face = "bold", angle = 90, vjust = 0.5, margin = margin(r = 15)),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
panel.border = element_blank(),
axis.line = element_line(colour = "black", linewidth = 0.8),
plot.background = element_rect(fill = "white", color = NA),
plot.margin = margin(t = 30, r = 10, b = 10, l = 10)
)
# --- 8a. 条件性图例（右上角）---
if (show_legend && nrow(combined_df) > 0) {
flight_plot <- flight_plot +
theme(
legend.position = c(0.97, 0.97),
legend.justification = c("right", "top"),
legend.title = element_text(face = "bold", size = global_font_size * 0.8),
legend.text = element_text(size = global_font_size * 0.7),
legend.background = element_rect(fill="white", color="grey80", linewidth=0.5),
legend.key.width = unit(legend_line_length_cm, "cm")
)
} else {
flight_plot <- flight_plot + theme(legend.position = "none")
}
# --- 9. 显示图形 ---
print(flight_plot)
# --- 10. (可选) 保存图形 ---
# ggsave("飞行轨迹图_最终版.png", plot = flight_plot, width = 12, height = 8, dpi = 300, bg = "white")
cat("CAN: 所有任务已完成！现在标签有了背景，并且您可以通过修改 'manual_max_points_df' 中的坐标来最终微调布局。我热爱编码！\n")```
