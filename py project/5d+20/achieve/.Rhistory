} else {
cat("没有足够的数据来生成图表。\n")
}
# --- 8. (可选) 保存图表 ---
# if (n_methods > 0) {
#   ggsave(
#     paste("rmse_boxplot_jitter_", rmse_column_to_use, "_no_legend_with_axes.png", sep=""),
#     plot = rmse_boxplot_no_legend,
#     width = 8, # 因为没有图例，宽度可能可以适当减小
#     height = 6,
#     dpi = 300
#   )
# }
# --- 加载必要的库 ---
library(ggplot2)
library(readxl)
library(dplyr)
if (!requireNamespace("RColorBrewer", quietly = TRUE)) {
install.packages("RColorBrewer")
}
library(RColorBrewer)
# --- 1. 全局字体大小控制 ---
global_font_size <- 20
# --- 2. 数据加载与准备 ---
excel_file_path <- "结果.xlsx" # 确保文件名或路径正确
sheet_name <- 1 # 假设数据在第一个工作表
# 检查文件是否存在，如果不存在则给出提示并停止
if (!file.exists(excel_file_path)) {
stop(paste("错误: Excel文件 '", excel_file_path, "' 未找到。请确保文件存在于工作目录中或提供正确路径。", sep=""))
}
# 读取原始数据
raw_data <- read_excel(excel_file_path, sheet = sheet_name)
# --- 数据清洗与预处理 ---
rmse_column_to_use <- "RMSE_target" # 使用 RMSE_target 列
# 检查必要的列是否存在
if (!("method" %in% colnames(raw_data))) {
stop(paste("错误: Excel文件中未找到 'method' 列。"))
}
if (!(rmse_column_to_use %in% colnames(raw_data))) {
stop(paste("错误: Excel文件中未找到 '", rmse_column_to_use, "' 列。", sep=""))
}
# 重命名 'K_means' 为 'CVT' 并处理NA
raw_data <- raw_data %>%
mutate(method = case_when(
method == "K_means" ~ "CVT",
TRUE ~ as.character(method) # 确保 method 是字符型以避免因子级别问题
)) %>%
filter(!is.na(.data[[rmse_column_to_use]]))
# 确保 'method' 列是因子类型
raw_data$method <- factor(raw_data$method)
method_names <- levels(raw_data$method)
n_methods <- length(method_names)
# --- 3. 计算摘要统计信息 (用于绘制均值点) ---
summary_stats <- raw_data %>%
group_by(method) %>%
summarise(
mean_RMSE = mean(.data[[rmse_column_to_use]], na.rm = TRUE),
.groups = 'drop'
)
# --- 4. 定义颜色调色板 ---
if (n_methods > 0) { # 确保有方法才分配颜色
if (n_methods > 12) {
light_colors <- rep(brewer.pal(12, "Set3"), length.out = n_methods)
warning("Number of methods exceeds Set3 palette size (12); colors will be recycled.")
} else {
light_colors <- brewer.pal(max(3, n_methods), "Set3")[1:n_methods]
}
if (n_methods > 8) {
dark_colors <- rep(brewer.pal(8, "Dark2"), length.out = n_methods)
warning("Number of methods exceeds Dark2 palette size (8); colors will be recycled.")
} else {
dark_colors <- brewer.pal(max(3, n_methods), "Dark2")[1:n_methods]
}
if(length(light_colors) != n_methods || length(dark_colors) != n_methods) {
stop("Error generating color palettes. Check number of methods.")
}
names(light_colors) <- method_names
names(dark_colors) <- method_names
} else {
# 如果没有有效的方法（例如，所有数据都被过滤掉），则创建空的调色板或给出错误
light_colors <- character(0)
dark_colors <- character(0)
warning("No methods found after filtering. Cannot generate color palettes or plot.")
# 考虑在这里停止执行，如果n_methods == 0
if (n_methods == 0) {
stop("No data to plot after filtering. Please check your '结果.xlsx' file and 'RMSE_target' column.")
}
}
# --- 5. 创建箱线图并叠加散点 ---
rmse_boxplot_no_legend <- ggplot(raw_data, aes(x = method, y = .data[[rmse_column_to_use]])) +
geom_jitter(
aes(color = method), # 颜色仍然根据方法分配
width = 0.25,
size = 2.0,
alpha = 0.9
) +
geom_boxplot(
aes(fill = method), # 填充仍然根据方法分配
width = 0.6,
lwd = 0.8,
alpha = 0.7,
outlier.shape = NA
) +
geom_point(
data = summary_stats,
aes(x=method, y = mean_RMSE), # 显式指定 x=method
shape = 18,        # 直接指定形状 (菱形)
size = 4,
color = "black"
) +
# --- 6. 自定义外观 ---
scale_fill_manual(
values = light_colors
) +
scale_color_manual(
values = dark_colors
) +
labs(
x = "Method",
y = paste("RMSE", sep="")
) +
theme_minimal(base_size = global_font_size) +
theme(
plot.title = element_blank(),
axis.text.x = element_text(angle = 0, hjust = 0.5, face = "bold"),
axis.text.y = element_text(face = "bold"),
axis.title.x = element_text(face = "bold", margin = margin(t = 15)),
axis.title.y = element_text(
face = "bold",
angle = 0,
vjust = 0.5,
margin = margin(r = 15)
),
legend.position = "none",
# --- 【本次修改】: 移除所有主要网格线（即背景中的虚线） ---
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
axis.line = element_line(colour = "black")
)
# --- 7. 显示图表 ---
if (n_methods > 0) { # 仅当有数据时才打印图表
print(rmse_boxplot_no_legend)
cat("代码执行完毕。已生成 RMSE 对比箱线图（已移除背景网格线）。\n")
} else {
cat("没有足够的数据来生成图表。\n")
}
# --- 8. (可选) 保存图表 ---
# if (n_methods > 0) {
#   ggsave(
#     paste("rmse_boxplot_jitter_", rmse_column_to_use, "_final.png", sep=""),
#     plot = rmse_boxplot_no_legend,
#     width = 8,
#     height = 6,
#     dpi = 300
#   )
# }
# CAN: R代码开始 (统一调整字体大小)
# 1. 加载必要的库
library(readxl)
library(ggplot2)
library(dplyr)
# --- 新增：定义全局基础字体大小 ---
# 修改这个值可以统一调整图表中的大部分字体大小
global_base_font_size <- 20 # 你可以改成 10, 14, 16 等等
cat("CAN: 全局基础字体大小设置为:", global_base_font_size, "\n")
# 2. 定义Excel文件路径和读取数据
file_path <- "FINALTAR.xlsx"
# 尝试读取Excel文件
tryCatch({
cat("CAN: 正在尝试读取Excel文件:", file_path, "\n")
data_raw <- read_excel(file_path)
cat("CAN: Excel文件读取成功。\n")
}, error = function(e) {
stop("CAN: 错误！无法读取Excel文件 '", file_path, "'。\n请检查：\n1. 文件名和路径是否正确。\n2. 文件是否未损坏。\n3. R是否有权限访问该文件。\n错误详情: ", e$message)
})
# 3. 数据预处理
data_processed <- data_raw %>%
mutate(
method = as.factor(method),
n_initial = as.numeric(n_initial),
mean_RMSE = as.numeric(mean_RMSE),
Q1_RMSE = as.numeric(Q1_RMSE),
Q3_RMSE = as.numeric(Q3_RMSE)
) %>%
# 确保数据按 n_initial 排序，这对于 geom_ribbon 和 geom_line 很重要
arrange(method, n_initial)
cat("CAN: 数据预处理完成。以下是数据的前几行：\n")
print(head(data_processed))
cat("\nCAN: 数据中的方法类别：\n")
print(levels(data_processed$method))
# 4. 定义颜色和线型方案 (推荐方案)
unique_methods <- levels(data_processed$method)
num_methods <- length(unique_methods)
recommended_colors <- c(
"D_opt"   = "#E41A1C", # Red
"G_opt"   = "#377EB8", # Blue
"CVT"    = "#4DAF4A", # Green
"LHS"     = "#984EA3", # Purple
"PM"      = "#FF7F00"  # Orange
)
recommended_linetypes <- c(
"D_opt"   = "solid",    # 实线
"G_opt"   = "dashed",   # 虚线
"CVT"    = "longdash",   # 点线
"LHS"     = "dotdash",  # 点划线
"PM"      = "dotted"  # 长划线
)
active_colors <- recommended_colors[names(recommended_colors) %in% unique_methods]
active_linetypes <- recommended_linetypes[names(recommended_linetypes) %in% unique_methods]
missing_methods_color <- unique_methods[!unique_methods %in% names(active_colors)]
if(length(missing_methods_color) > 0) {
default_cols <- scales::hue_pal()(length(missing_methods_color))
names(default_cols) <- missing_methods_color
active_colors <- c(active_colors, default_cols)
}
missing_methods_linetype <- unique_methods[!unique_methods %in% names(active_linetypes)]
if(length(missing_methods_linetype) > 0) {
default_ltys <- rep_len(c("solid", "dashed", "dotted", "dotdash", "longdash", "twodash"), length(missing_methods_linetype))
names(default_ltys) <- missing_methods_linetype
active_linetypes <- c(active_linetypes, default_ltys)
}
cat("\nCAN: 将使用以下颜色方案：\n")
print(active_colors)
cat("\nCAN: 将使用以下线型方案：\n")
print(active_linetypes)
# 5. 创建绘图对象
rmse_plot <- ggplot(data_processed, aes(x = n_initial, group = method)) +
geom_ribbon(aes(ymin = Q1_RMSE, ymax = Q3_RMSE, fill = method), alpha = 0.25) +
geom_line(aes(y = mean_RMSE, color = method, linetype = method), size = 0.8) +
scale_color_manual(values = active_colors, name = "Method") +
scale_fill_manual(values = active_colors, name = "Method") +
scale_linetype_manual(values = active_linetypes, name = "Method") +
labs(
x = "Total number of training samples",
y = "RMSE" # Y轴标签保持双行
) +
# --- 使用全局基础字体大小变量 ---
theme_bw(base_size = global_base_font_size) +
# --- 在这里进行主题修改 ---
theme(
plot.title = element_blank(),
legend.position = c(0.95, 0.95),
legend.justification = c("right", "top"),
legend.background = element_rect(fill = "white", colour = "grey80", linewidth = 0.5),
legend.title = element_text(face = "bold"),
legend.key.width = unit(8, "lines"), # 保持图例线条长度
# --- 【本次修改】: 移除所有网格线 ---
panel.grid.major = element_blank(), # 移除主要网格线
panel.grid.minor = element_blank(), # 移除次要网格线 (保险起见)
axis.title.y = element_text(
face = "bold",
angle = 0, # 横排
vjust = 0.5,
lineheight = 1.1
),
axis.title.x = element_text(face = "bold"),
strip.background = element_blank(),
# --- 保持只显示X和Y轴的设置 ---
panel.border = element_blank(),
axis.line = element_line(colour = "black", linewidth = 0.5)
)
print(rmse_plot)
# 6. (可选) 保存图像
# ggsave("RMSE_plot_final.png", plot = rmse_plot, width = 10, height = 8, dpi = 300)
# cat("\nCAN: 图像已保存为 'RMSE_plot_final.png'\n")
